{
  "version": "v3_policy_safe_multisignal",
  "run_id": "v3_policy_safe_multisignal",
  "config_name": "v3_policy_safe_multisignal",
  "shared_model_path": "artifacts/models/jaws_browsergym_shared_ppo_v3_policy_safe_multisignal.pt",
  "output_dir": "artifacts/multisite/v3_policy_safe_multisignal",
  "training_log_dir": "artifacts/training_logs/v3_policy_safe_multisignal",
  "evaluation_output_dir": "artifacts/evaluation/v3_policy_safe_multisignal",
  "reward_mode": "signal_based",
  "use_known_bug_reward": false,
  "use_known_bug_for_training": false,
  "use_known_bug_for_evaluation": false,
  "training_uses_site_specific_bug_catalog": false,
  "policy_uses_bug_labels": false,
  "total_updates": 10,
  "episodes_per_site": 2,
  "eval_episodes": 1,
  "max_steps": 15,
  "site_timeout_seconds": 240,
  "episode_timeout_seconds": 120,
  "reset_timeout_ms": 60000,
  "reset_retry_count": 1,
  "no_progress_patience": 4,
  "enable_guided_actions": false,
  "debug_action_mask": false,
  "target_signal_types": [
    "ui-dom",
    "interaction",
    "layout",
    "console-error",
    "runtime-exception",
    "network-error",
    "api-4xx",
    "api-5xx",
    "api-timeout",
    "api-ui-mismatch",
    "api-success-ui-failure",
    "api-failure-ui-success",
    "db-persistence-mismatch",
    "stale-data-rendering",
    "auth-permission-anomaly",
    "sensitive-data-exposure",
    "token-exposure",
    "server-infra-error",
    "static-asset-failure"
  ],
  "sites": [
    {
      "site_id": "site001",
      "base_url": "http://127.0.0.1:9220",
      "enabled": true,
      "site_group": "ui_dom",
      "has_bug_catalog": true,
      "bug_catalog_path": "datasets/site001/bug_catalog.json",
      "reward_scale": 0.5,
      "target_signal_types": ["ui-dom", "interaction"]
    },
    {
      "site_id": "site003",
      "base_url": "http://localhost:9222",
      "enabled": true,
      "site_group": "ui_layout",
      "has_bug_catalog": true,
      "bug_catalog_path": "datasets/site003/bug_catalog.json",
      "reward_scale": 1.2,
      "target_signal_types": ["ui-dom", "layout"]
    },
    {
      "site_id": "site_console_001",
      "base_url": "http://localhost:9365",
      "enabled": false,
      "site_group": "console_runtime",
      "has_bug_catalog": false,
      "target_signal_types": ["console-error", "runtime-exception"],
      "note": "TODO: enable when a local console/runtime signal fixture is available."
    },
    {
      "site_id": "site_network_001",
      "base_url": "http://localhost:9366",
      "enabled": false,
      "site_group": "network_api",
      "has_bug_catalog": false,
      "target_signal_types": ["network-error", "api-4xx", "api-5xx", "api-timeout"],
      "note": "TODO: enable when a local requestfailed/API 4xx/5xx fixture is available."
    },
    {
      "site_id": "site_api_ui_001",
      "base_url": "http://localhost:9367",
      "enabled": false,
      "site_group": "cross_layer",
      "has_bug_catalog": false,
      "target_signal_types": ["api-ui-mismatch", "api-success-ui-failure", "api-failure-ui-success"],
      "note": "TODO: enable when an API-success/UI-failure fixture is available."
    },
    {
      "site_id": "site_db_001",
      "base_url": "http://localhost:9368",
      "enabled": false,
      "site_group": "db",
      "has_bug_catalog": false,
      "target_signal_types": ["db-persistence-mismatch", "stale-data-rendering"],
      "note": "TODO: enable when a local DB persistence/stale rendering fixture is available."
    },
    {
      "site_id": "site_security_001",
      "base_url": "http://localhost:9369",
      "enabled": false,
      "site_group": "security",
      "has_bug_catalog": false,
      "target_signal_types": ["auth-permission-anomaly", "sensitive-data-exposure", "token-exposure"],
      "note": "TODO: enable when a local auth/token exposure signal fixture is available."
    },
    {
      "site_id": "site_server_001",
      "base_url": "http://localhost:9370",
      "enabled": false,
      "site_group": "server_infra",
      "has_bug_catalog": false,
      "target_signal_types": ["server-infra-error", "static-asset-failure"],
      "note": "TODO: enable when a local server/infra fixture is available."
    }
  ]
}
